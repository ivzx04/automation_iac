[Unit]
Description=Reverse proxy (Caddy) for automation-pipeline
After=automation-network.service
Requires=automation-network.service

[Container]
Image=docker.io/library/caddy:2.11.4-alpine
Network=automation.network
PublishPort=443:443

# configuration data
Volume=${HOME}/.local/share/containers/Caddyfile:/etc/caddy/Caddyfile:ro
Volume=/srv/caddy/certs/n8n.automation.caisa.bit.uni-bonn.de/:/etc/letsencrypt/live/n8n.automation.caisa.bit.uni-bonn.de/:ro
Volume=/srv/caddy/certs/admin.automation.caisa.bit.uni-bonn.de/:/etc/letsencrypt/live/admin.automation.caisa.bit.uni-bonn.de/:ro

# persistent application data
Volume=caddy-data:/data
ContainerName=automation-caddy

[Service]
Restart=always

[Install]
WantedBy=default.target
